# Copy to .env, change every password, and keep the file private.
NEXO_DOMAIN=escuela.ejemplo.edu.ar
DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=escuela.ejemplo.edu.ar
DJANGO_CSRF_TRUSTED_ORIGINS=https://escuela.ejemplo.edu.ar
POSTGRES_USER=nexo_owner
POSTGRES_PASSWORD=change-this-owner-password
NEXO_DB_USER=nexo_app
NEXO_DB_PASSWORD=change-this-app-password
TIME_ZONE=America/Argentina/Buenos_Aires
EMAIL_HOST=smtp.example.edu.ar
EMAIL_PORT=587
EMAIL_HOST_USER=nexo@example.edu.ar
EMAIL_HOST_PASSWORD=replace-this
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Nexo Escolar <no-reply@example.edu.ar>
