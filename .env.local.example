# SMTP local con Gmail. Copiá este archivo como .env.local y completá los datos.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=pega-la-clave-de-aplicacion-sin-espacios
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Nexo Escolar <tu-cuenta@gmail.com>
# Número de WhatsApp internacional, solo dígitos y sin + (ej.: 5491112345678).
NEXO_WHATSAPP_NUMBER=
